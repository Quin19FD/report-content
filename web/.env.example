# ==========================================
# CẤU HÌNH TỰ ĐỘNG ĐỒNG BỘ KÊNH (STUDIO AUTO-SYNC)
# ==========================================

# 1. BẢO MẬT TIẾN TRÌNH CRON (Tùy chọn)
# Chuỗi bảo mật ngẫu nhiên để chỉ có Vercel Cron hoặc Admin mới kích hoạt được
CRON_SECRET=cf_cron_secret_key_2026

# 2. FACEBOOK FANPAGE (Meta Graph API)
# Lấy Page ID: Vào Fanpage -> Giới thiệu (hoặc link trang facebook.com/8syncdev)
FACEBOOK_PAGE_ID=
# Lấy Page Access Token: developers.facebook.com/tools/explorer hoặc Meta Business Manager
FACEBOOK_PAGE_ACCESS_TOKEN=

# 3. YOUTUBE CHANNEL (YouTube Data API v3)
# Lấy API Key: console.cloud.google.com -> Kích hoạt YouTube Data API v3 -> Tạo API Key
YOUTUBE_API_KEY=
# ID kênh YouTube (Bắt đầu bằng UC...)
YOUTUBE_CHANNEL_ID=UCMWzM6NOoVvr9484XBSJEjg

# 4. BOT THÔNG BÁO TỔNG KẾT NGÀY (Webhook Lark / Telegram / Feishu)
NOTIFICATION_WEBHOOK_URL=

# 5. CƠ SỞ DỮ LIỆU CLOUD TURSO (Khi deploy Vercel / Production)
# Nếu chạy local, để trống hệ thống sẽ tự dùng file SQLite local
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
